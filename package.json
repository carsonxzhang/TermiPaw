{
  "name": "termipaw",
  "private": true,
  "version": "0.7.2",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "node scripts/build.mjs",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "tauri build --debug --no-bundle && cargo build --manifest-path src-tauri/Cargo.toml --example dev_server --example fake_editor && node tests/e2e/run.mjs",
    "release": "node scripts/release.mjs",
    "test:openssh": "tauri build --debug --no-bundle && cargo build --manifest-path src-tauri/Cargo.toml --example test_agent --example fake_editor && node tests/e2e/openssh.mjs",
    "test:footprint": "node tests/footprint.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
