{
  "name": "termipaw",
  "private": true,
  "version": "0.7.2",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "node scripts/build.mjs",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "tauri build --debug --no-bundle && cargo build --manifest-path src-tauri/Cargo.toml --example dev_server --example fake_editor && node tests/e2e/run.mjs",
    "release": "node scripts/release.mjs",
    "test:openssh": "tauri build --debug --no-bundle && cargo build --manifest-path src-tauri/Cargo.toml --example test_agent --example fake_editor && node tests/e2e/openssh.mjs",
    "test:footprint": "node tests/footprint.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
