{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TermiPaw",
  "version": "0.7.2",
  "identifier": "dev.termipaw.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "TermiPaw",
        "width": 1200,
        "height": 760,
        "minWidth": 820,
        "minHeight": 520,
        "decorations": false,
        "center": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFQzRBRkU3Q0E2NDU3NUYKUldSZlYyVEs1Ni9FdnU5OU1xM1hhbzVpZ3JDVVh5M1JPSkJFOHcwRUJleXZoTUxCQUlDSzlqYUMK",
      "endpoints": ["https://github.com/carsonxzhang/TermiPaw/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  }
}
